<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Math Corse — Private Search</title>
<style>
:root{color-scheme:dark;--bg:#070c15;--panel:#0d1727;--line:#1e314d;--muted:#9bb3d4;--blue:#367cff;--text:#f3f7ff}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 50% 10%,#10244a 0,transparent 48%),var(--bg);color:var(--text);font:16px/1.5 system-ui,-apple-system,Segoe UI,sans-serif}
header{height:76px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 24px;background:#070c15e8;position:sticky;top:0;z-index:5}
.brand{font-weight:800;font-size:25px;letter-spacing:-.7px}.brand span{color:var(--blue)}.status{color:#9cc7ff;border:1px solid #23466d;border-radius:30px;padding:8px 14px;font-size:13px}
.layout{display:grid;grid-template-columns:230px 1fr;min-height:calc(100vh - 76px)}aside{border-right:1px solid var(--line);padding:22px 14px}.nav{display:block;width:100%;padding:12px 14px;border:0;background:transparent;color:var(--muted);text-align:left;border-radius:10px;font:inherit;cursor:pointer;margin-bottom:5px}.nav:hover,.nav.active{background:#17315b;color:#fff}.privacy{margin-top:32px;border:1px solid var(--line);border-radius:14px;padding:18px;color:var(--muted);font-size:14px}.privacy strong{display:block;color:#fff;font-size:18px;margin-bottom:6px}
main{padding:50px clamp(18px,4vw,58px);min-width:0}.hero{text-align:center;max-width:980px;margin:0 auto 28px}.lock{font-size:42px;color:#4786ff}.hero h1{font-size:clamp(36px,5vw,56px);line-height:1.1;margin:8px 0}.hero h1 span{color:#4384ff}.hero p{color:var(--muted);font-size:18px;margin:12px 0 24px}
.search{display:flex;gap:12px;background:#101e33;border:1px solid #2b4770;border-radius:18px;padding:8px;box-shadow:0 10px 45px #0005}.search input{flex:1;min-width:0;background:transparent;border:0;outline:0;color:#fff;font:inherit;padding:12px}.search button,.primary{border:0;border-radius:12px;background:var(--blue);color:white;padding:12px 20px;font:inherit;font-weight:700;cursor:pointer}.search button:hover,.primary:hover{background:#2367e8}.hint{color:#8ea8ca;font-size:13px;margin-top:12px}
.results{max-width:1100px;margin:30px auto 0;background:#0b1422;border:1px solid var(--line);border-radius:16px;overflow:hidden}.result-head{padding:16px 22px;border-bottom:1px solid var(--line);display:flex;gap:20px;align-items:center;flex-wrap:wrap}.tab{background:transparent;border:0;color:var(--muted);font:inherit;padding:6px;cursor:pointer}.tab.active{color:#69a0ff;border-bottom:2px solid #4384ff}.result-body{padding:22px}.welcome{color:var(--muted);text-align:center;padding:26px}.item{padding:16px 0;border-bottom:1px solid #1b2b41}.item:last-child{border:0}.item a{color:#6da2ff;text-decoration:none;font-size:19px}.item a:hover{text-decoration:underline}.url{font-size:13px;color:#77c69a}.snippet{color:#b4c5dc;margin-top:5px}.empty{color:var(--muted);padding:20px 0}.notice{font-size:13px;color:#91a6c2;border-top:1px solid var(--line);padding:14px 22px}
iframe{width:100%;height:65vh;border:1px solid var(--line);border-radius:12px;background:white} .hidden{display:none}
@media(max-width:760px){.layout{grid-template-columns:1fr}aside{border-right:0;border-bottom:1px solid var(--line);padding:8px;display:flex;gap:5px;overflow:auto}.nav{white-space:nowrap;width:auto;margin:0;padding:9px 12px}.privacy{display:none}header{padding:0 14px}.status{display:none}main{padding:30px 14px}.search{gap:4px}.search button{padding:10px 13px}}
</style>
</head>
<body>
<header><div class="brand">🔒 Math <span>Corse</span></div><div class="status">● Private search interface</div></header>
<div class="layout">
<aside>
<button class="nav active" data-view="search">⌂ &nbsp; Home / Search</button>
<button class="nav" data-view="bookmarks">☆ &nbsp; Bookmarks</button>
<button class="nav" data-view="history">◷ &nbsp; Recent searches</button>
<div class="privacy"><strong>🛡 Stay private</strong>Searches are kept in this browser only when you use the recent-search feature.<br><br>✓ No account required<br>✓ Simple interface<br>✓ Mobile friendly</div>
</aside>
<main>
<section class="hero" id="hero">
<div class="lock">🔒</div><h1>Math <span>Corse</span></h1>
<p>Search privately. Browse from one simple interface.</p>
<form class="search" id="searchForm"><input id="query" aria-label="Search the web" placeholder="Search with DuckDuckGo…" autocomplete="off" required><button type="submit">Search ↗</button></form>
<div class="hint">DuckDuckGo-powered lookup · Results appear below when available</div>
</section>
<section class="results" id="results">
<div class="result-head"><button class="tab active">Web search</button><span id="resultLabel" style="color:var(--muted);font-size:13px">Ready to search</span></div>
<div class="result-body" id="resultBody"><div class="welcome">Enter a search above to see available DuckDuckGo instant-answer results here.</div></div>
<div class="notice">Note: This demo uses DuckDuckGo's Instant Answer API, not its complete web-results index. Some queries return no instant answers. A server-side search integration is needed for full results and reliable in-site browsing.</div>
</section>
<section class="results hidden" id="bookmarksView"><div class="result-head">Bookmarks</div><div class="result-body" id="bookmarksBody"><div class="empty">Save a result using ☆ when available.</div></div></section>
<section class="results hidden" id="historyView"><div class="result-head">Recent searches</div><div class="result-body" id="historyBody"><div class="empty">Your searches will appear here during this session.</div></div></section>
<section class="results hidden" id="browserView"><div class="result-head"><button class="tab" id="backToSearch">← Back to results</button><span id="browserTitle">In-site view</span></div><div class="result-body" id="frameWrap"></div><div class="notice">Some sites block embedding for security reasons. If a page refuses to load, this demo cannot bypass that restriction.</div></section>
</main>
</div>
<script>
const $=s=>document.querySelector(s);
const historyItems=[], bookmarks=[];
function safeUrl(raw){try{const u=new URL(raw);return ['http:','https:'].includes(u.protocol)?u.href:null}catch{return null}}
function switchView(name){
  $('#hero').classList.toggle('hidden',name==='bookmarks'||name==='history');
  ['results','bookmarksView','historyView','browserView'].forEach(id=>$('#'+id).classList.add('hidden'));
  if(name==='search')$('#results').classList.remove('hidden');
  if(name==='bookmarks'){ $('#bookmarksView').classList.remove('hidden'); renderBookmarks(); }
  if(name==='history'){ $('#historyView').classList.remove('hidden'); renderHistory(); }
  if(name==='browser')$('#browserView').classList.remove('hidden');
  document.querySelectorAll('.nav').forEach(b=>b.classList.toggle('active',b.dataset.view===name));
}
document.querySelectorAll('.nav').forEach(b=>b.addEventListener('click',()=>switchView(b.dataset.view)));
$('#backToSearch').onclick=()=>switchView('search');
function makeItem(title,url,description){
 const valid=safeUrl(url); if(!valid)return null;
 const el=document.createElement('article');el.className='item';
 const link=document.createElement('a');link.href='#';link.textContent=title;link.onclick=e=>{e.preventDefault();openInside(valid,title)};
 const domain=document.createElement('div');domain.className='url';domain.textContent=new URL(valid).hostname;
 const desc=document.createElement('div');desc.className='snippet';desc.textContent=description||'';
 const save=document.createElement('button');save.className='nav';save.style.display='inline-block';save.style.width='auto';save.textContent='☆ Save';save.onclick=()=>{if(!bookmarks.some(b=>b.url===valid))bookmarks.push({title,url:valid,description});save.textContent='★ Saved';};
 el.append(link,domain,desc,save);return el;
}
function openInside(url,title){
 switchView('browser');$('#browserTitle').textContent=title;$('#frameWrap').replaceChildren();
 const frame=document.createElement('iframe');frame.title=title;frame.referrerPolicy='no-referrer';frame.src=url;
 $('#frameWrap').append(frame);
}
$('#searchForm').addEventListener('submit',async e=>{
 e.preventDefault();const q=$('#query').value.trim();if(!q)return;
 switchView('search');$('#resultLabel').textContent='Searching…';$('#resultBody').replaceChildren();
 historyItems.unshift(q);
 try{
  const response=await fetch('https://api.duckduckgo.com/?q='+encodeURIComponent(q)+'&format=json&no_html=1&skip_disambig=1');
  if(!response.ok)throw new Error('Search request failed');
  const data=await response.json();const frag=document.createDocumentFragment();let count=0;
  if(data.AbstractText&&data.AbstractURL){const n=makeItem(data.Heading||q,data.AbstractURL,data.AbstractText);if(n){frag.append(n);count++}}
  if(data.Answer){const p=document.createElement('p');p.textContent=data.Answer;frag.append(p);count++}
  function topics(items){for(const x of items||[]){if(x.Topics)topics(x.Topics);else if(x.FirstURL&&x.Text){const n=makeItem(x.Text.split(' - ')[0],x.FirstURL,x.Text);if(n){frag.append(n);count++}}}}
  topics(data.RelatedTopics);
  $('#resultBody').replaceChildren(frag);
  if(!count){const p=document.createElement('div');p.className='empty';p.textContent='No instant answers were returned for this query. Full web search results require a search provider or backend that supports them.';$('#resultBody').append(p)}
  $('#resultLabel').textContent=count+' instant-answer result(s)';
 }catch(err){
  const p=document.createElement('div');p.className='empty';p.textContent='Could not load DuckDuckGo instant answers. Your browser may be blocking this request. For a production version, connect a backend search endpoint.';$('#resultBody').replaceChildren(p);$('#resultLabel').textContent='Search unavailable';
 }
});
function renderBookmarks(){const body=$('#bookmarksBody');body.replaceChildren();if(!bookmarks.length){body.textContent='No bookmarks saved yet.';body.className='empty';return}body.className='';bookmarks.forEach(b=>body.append(makeItem(b.title,b.url,b.description)))}
function renderHistory(){const body=$('#historyBody');body.replaceChildren();if(!historyItems.length){body.textContent='No searches yet.';body.className='empty';return}body.className='';historyItems.forEach(q=>{const p=document.createElement('p');p.textContent='⌕ '+q;p.style.cursor='pointer';p.onclick=()=>{$('#query').value=q;$('#searchForm').requestSubmit()};body.append(p)})}
</script>
</body>
</html>